---
import Layout from '../../layouts/Layout.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const posts = [
  {
    slug: 'cuando-cambiar-aceite-coche',
    titulo: '¿Cada cuánto hay que cambiar el aceite del coche?',
    resumen: 'Descubre cada cuántos kilómetros debes cambiar el aceite de tu vehículo y por qué es tan importante para el motor.',
    fecha: '15 de marzo de 2026',
    imagen: 'https://images.unsplash.com/photo-1487754180451-c456f719a1fc?w=600&q=80',
    categoria: 'Mantenimiento',
  },
  {
    slug: 'preparar-coche-itv',
    titulo: 'Cómo preparar tu coche para pasar la ITV a la primera',
    resumen: 'Guía completa con todos los puntos que debes revisar antes de llevar tu vehículo a la inspección técnica.',
    fecha: '8 de marzo de 2026',
    imagen: 'https://images.unsplash.com/photo-1530046339160-ce3e530c7d2f?w=600&q=80',
    categoria: 'ITV',
  },
  {
    slug: 'senales-cambiar-frenos',
    titulo: '5 señales de que necesitas cambiar los frenos de tu coche',
    resumen: 'Aprende a identificar los síntomas de desgaste en el sistema de frenado y cuándo acudir al taller.',
    fecha: '1 de marzo de 2026',
    imagen: 'https://images.unsplash.com/photo-1619642751034-765dfdf7c58e?w=600&q=80',
    categoria: 'Seguridad',
  },
];
---

<Layout title="Blog - Talleres AutoMarcos" description="Blog de Talleres AutoMarcos: consejos de mantenimiento, guías para la ITV y todo lo que necesitas saber sobre el cuidado de tu vehículo.">
  <section style="padding:64px 0 96px;background:#080808;">
    <div style="max-width:1280px;margin:0 auto;padding:0 16px;">
      <div style="text-align:center;margin-bottom:64px;">
        <h1 style="font-family:'Oswald',sans-serif;font-size:clamp(2.5rem,5vw,4rem);font-weight:700;color:#fff;text-transform:uppercase;margin-bottom:16px;">Blog</h1>
        <p style="color:#9ca3af;font-size:1.1rem;max-width:768px;margin:0 auto;">Consejos, guías y todo lo que necesitas saber para mantener tu vehículo en las mejores condiciones.</p>
      </div>

      <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:32px;" class="grid-auto">
        {posts.map((post) => (
          <article style="background:#161616;border-radius:2px;overflow:hidden;border:1px solid #222;">
            <a href={`${base}/blog/${post.slug}`} style="display:block;text-decoration:none;">
              <div style="aspect-ratio:16/9;overflow:hidden;">
                <img src={post.imagen} alt={post.titulo} loading="lazy" style="width:100%;height:100%;object-fit:cover;" />
              </div>
              <div style="padding:24px;">
                <div style="display:flex;align-items:center;gap:12px;margin-bottom:12px;">
                  <span style="font-size:0.75rem;font-weight:600;color:#F5A623;background:rgba(245,166,35,0.1);padding:4px 12px;border-radius:2px;">{post.categoria}</span>
                  <span style="font-size:0.75rem;color:#6b7280;">{post.fecha}</span>
                </div>
                <h2 style="font-family:'Oswald',sans-serif;font-size:1.1rem;font-weight:600;color:#fff;margin-bottom:8px;">{post.titulo}</h2>
                <p style="color:#9ca3af;font-size:0.9rem;line-height:1.5;">{post.resumen}</p>
                <span style="display:inline-block;margin-top:16px;color:#F5A623;font-size:0.85rem;font-family:'Oswald',sans-serif;text-transform:uppercase;">Leer más →</span>
              </div>
            </a>
          </article>
        ))}
      </div>
    </div>
  </section>
</Layout>
