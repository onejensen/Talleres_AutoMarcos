---
import Layout from '../../layouts/Layout.astro';

const posts = [
  {
    slug: 'cuando-cambiar-aceite-coche',
    titulo: '¿Cada cuánto hay que cambiar el aceite del coche?',
    resumen: 'Descubre cada cuántos kilómetros debes cambiar el aceite de tu vehículo y por qué es tan importante para el motor.',
    fecha: '15 de marzo de 2026',
    imagen: 'https://images.unsplash.com/photo-1487754180451-c456f719a1fc?w=600&q=80',
    categoria: 'Mantenimiento',
  },
  {
    slug: 'preparar-coche-itv',
    titulo: 'Cómo preparar tu coche para pasar la ITV a la primera',
    resumen: 'Guía completa con todos los puntos que debes revisar antes de llevar tu vehículo a la inspección técnica.',
    fecha: '8 de marzo de 2026',
    imagen: 'https://images.unsplash.com/photo-1530046339160-ce3e530c7d2f?w=600&q=80',
    categoria: 'ITV',
  },
  {
    slug: 'senales-cambiar-frenos',
    titulo: '5 señales de que necesitas cambiar los frenos de tu coche',
    resumen: 'Aprende a identificar los síntomas de desgaste en el sistema de frenado y cuándo acudir al taller.',
    fecha: '1 de marzo de 2026',
    imagen: 'https://images.unsplash.com/photo-1619642751034-765dfdf7c58e?w=600&q=80',
    categoria: 'Seguridad',
  },
];
---

<Layout title="Blog - Talleres AutoMarcos" description="Blog de Talleres AutoMarcos: consejos de mantenimiento, guías para la ITV y todo lo que necesitas saber sobre el cuidado de tu vehículo.">
  <section class="py-16 md:py-24 bg-darker">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-16">
        <h1 class="text-4xl md:text-5xl font-bold text-white mb-4">Blog</h1>
        <p class="text-gray-400 text-lg max-w-3xl mx-auto">Consejos, guías y todo lo que necesitas saber para mantener tu vehículo en las mejores condiciones.</p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {posts.map((post) => (
          <article class="bg-surface rounded-2xl overflow-hidden border border-gray-800 hover:border-accent/50 transition-colors group">
            <a href={`/blog/${post.slug}`} class="block">
              <div class="aspect-video overflow-hidden">
                <img src={post.imagen} alt={post.titulo} loading="lazy" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" />
              </div>
              <div class="p-6">
                <div class="flex items-center gap-3 mb-3">
                  <span class="text-xs font-semibold text-accent bg-accent/10 px-3 py-1 rounded-full">{post.categoria}</span>
                  <span class="text-xs text-gray-500">{post.fecha}</span>
                </div>
                <h2 class="text-lg font-semibold text-white mb-2 group-hover:text-accent transition-colors">{post.titulo}</h2>
                <p class="text-gray-400 text-sm leading-relaxed">{post.resumen}</p>
                <span class="inline-block mt-4 text-accent text-sm font-medium">Leer más &rarr;</span>
              </div>
            </a>
          </article>
        ))}
      </div>
    </div>
  </section>
</Layout>
