---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Contacto - Talleres AutoMarcos" description="Contacta con Talleres AutoMarcos en Mallorca. Pide cita por WhatsApp, llámanos o visítanos en nuestro taller.">
  <section style="padding:120px 0 96px;background:#080808;">
    <div style="max-width:1280px;margin:0 auto;padding:0 16px;">
      <div style="text-align:center;margin-bottom:64px;">
        <h1 style="font-family:'Oswald',sans-serif;font-size:clamp(2.5rem,5vw,4rem);font-weight:700;color:#fff;text-transform:uppercase;margin-bottom:16px;">Contacto</h1>
        <p style="color:#9ca3af;font-size:1.1rem;max-width:768px;margin:0 auto;">Estamos aquí para ayudarte. Contacta con nosotros por el medio que prefieras.</p>
      </div>

      <div style="display:grid;grid-template-columns:1fr 1fr;gap:48px;" class="grid-auto">
        <!-- Formulario -->
        <div style="background:#161616;border-radius:2px;padding:32px;border:1px solid #222;">
          <h2 style="font-family:'Oswald',sans-serif;font-size:1.5rem;font-weight:700;color:#fff;margin-bottom:24px;">Envíanos un mensaje</h2>
          <form action="#" method="POST" style="display:flex;flex-direction:column;gap:20px;">
            <div>
              <label for="nombre" style="display:block;font-size:0.9rem;color:#d1d5db;margin-bottom:8px;">Nombre completo</label>
              <input type="text" id="nombre" name="nombre" required style="width:100%;padding:12px 16px;background:#080808;border:1px solid #333;border-radius:2px;color:#fff;font-size:1rem;" placeholder="Tu nombre">
            </div>
            <div>
              <label for="telefono" style="display:block;font-size:0.9rem;color:#d1d5db;margin-bottom:8px;">Teléfono</label>
              <input type="tel" id="telefono" name="telefono" style="width:100%;padding:12px 16px;background:#080808;border:1px solid #333;border-radius:2px;color:#fff;font-size:1rem;" placeholder="623 94 25 26">
            </div>
            <div>
              <label for="email" style="display:block;font-size:0.9rem;color:#d1d5db;margin-bottom:8px;">Email</label>
              <input type="email" id="email" name="email" required style="width:100%;padding:12px 16px;background:#080808;border:1px solid #333;border-radius:2px;color:#fff;font-size:1rem;" placeholder="tu@email.com">
            </div>
            <div>
              <label for="mensaje" style="display:block;font-size:0.9rem;color:#d1d5db;margin-bottom:8px;">Mensaje</label>
              <textarea id="mensaje" name="mensaje" rows="4" required style="width:100%;padding:12px 16px;background:#080808;border:1px solid #333;border-radius:2px;color:#fff;font-size:1rem;resize:none;" placeholder="Cuéntanos qué necesitas..."></textarea>
            </div>
            <button type="submit" style="width:100%;padding:16px;background:#F5A623;color:#0D0D0D;font-family:'Oswald',sans-serif;font-weight:700;border-radius:2px;border:none;cursor:pointer;font-size:1.1rem;text-transform:uppercase;letter-spacing:0.05em;">
              Enviar Mensaje
            </button>
          </form>
        </div>

        <!-- Info de contacto -->
        <div style="display:flex;flex-direction:column;gap:24px;">
          <!-- WhatsApp -->
          <a href="https://wa.me/34623942526?text=Hola%2C%20me%20gustar%C3%ADa%20pedir%20cita%20en%20Talleres%20AutoMarcos" target="_blank" rel="noopener noreferrer" style="display:block;background:rgba(37,211,102,0.1);border:1px solid rgba(37,211,102,0.3);border-radius:2px;padding:24px;text-decoration:none;">
            <div style="display:flex;align-items:center;gap:16px;">
              <div style="width:56px;height:56px;background:#25d366;border-radius:2px;display:flex;align-items:center;justify-content:center;flex-shrink:0;">
                <svg style="width:28px;height:28px;color:#fff;" fill="currentColor" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
              </div>
              <div>
                <h3 style="font-size:1.1rem;font-weight:600;color:#fff;font-family:'Oswald',sans-serif;">WhatsApp</h3>
                <p style="color:#9ca3af;">623 94 25 26</p>
                <p style="color:#25d366;font-size:0.85rem;margin-top:4px;">Respuesta rápida - Haz clic para chatear</p>
              </div>
            </div>
          </a>

          <!-- Teléfono -->
          <a href="tel:+34623942526" style="display:block;background:#161616;border:1px solid #222;border-radius:2px;padding:24px;text-decoration:none;">
            <div style="display:flex;align-items:center;gap:16px;">
              <div style="width:56px;height:56px;background:#F5A623;border-radius:2px;display:flex;align-items:center;justify-content:center;flex-shrink:0;">
                <svg style="width:28px;height:28px;color:#0D0D0D;" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
              </div>
              <div>
                <h3 style="font-size:1.1rem;font-weight:600;color:#fff;font-family:'Oswald',sans-serif;">Teléfono</h3>
                <p style="color:#9ca3af;">623 94 25 26</p>
              </div>
            </div>
          </a>

          <!-- Dirección -->
          <div style="background:#161616;border:1px solid #222;border-radius:2px;padding:24px;">
            <div style="display:flex;align-items:center;gap:16px;margin-bottom:16px;">
              <div style="width:56px;height:56px;background:#F5A623;border-radius:2px;display:flex;align-items:center;justify-content:center;flex-shrink:0;">
                <svg style="width:28px;height:28px;color:#0D0D0D;" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
              </div>
              <div>
                <h3 style="font-size:1.1rem;font-weight:600;color:#fff;font-family:'Oswald',sans-serif;">Dirección</h3>
                <p style="color:#9ca3af;">Carrer de Sant Joaquim, 25</p>
                <p style="color:#9ca3af;">Mallorca</p>
              </div>
            </div>
            <a href="https://www.google.com/maps/search/?api=1&query=Carrer+de+Sant+Joaquim+25+Mallorca" target="_blank" rel="noopener noreferrer" style="display:flex;align-items:center;justify-content:center;gap:8px;width:100%;padding:12px;background:#F5A623;color:#0D0D0D;font-family:'Oswald',sans-serif;font-weight:700;font-size:0.9rem;text-decoration:none;border-radius:2px;text-transform:uppercase;letter-spacing:0.05em;">
              <svg style="width:18px;height:18px;" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 20l-5.447-2.724A1 1 0 013 16.382V5.618a1 1 0 011.447-.894L9 7m0 13l6-3m-6 3V7m6 10l4.553 2.276A1 1 0 0021 18.382V7.618a1 1 0 00-.553-.894L15 4m0 13V4m0 0L9 7"/></svg>
              Cómo ir
            </a>
          </div>

          <!-- Horario -->
          <div style="background:#161616;border:1px solid #222;border-radius:2px;padding:24px;">
            <div style="display:flex;align-items:center;gap:16px;">
              <div style="width:56px;height:56px;background:#F5A623;border-radius:2px;display:flex;align-items:center;justify-content:center;flex-shrink:0;">
                <svg style="width:28px;height:28px;color:#0D0D0D;" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
              </div>
              <div>
                <h3 style="font-size:1.1rem;font-weight:600;color:#fff;font-family:'Oswald',sans-serif;">Horario</h3>
                <p style="color:#9ca3af;">Lunes a Sábado: 09:00 - 16:00</p>
                <p style="color:#6b7280;font-size:0.85rem;">Domingo: Cerrado</p>
              </div>
            </div>
          </div>

          <!-- Instagram -->
          <a href="https://www.instagram.com/talleres_automarcos" target="_blank" rel="noopener noreferrer" style="display:flex;align-items:center;justify-content:center;gap:12px;width:100%;padding:18px 24px;background:linear-gradient(45deg,#f09433,#e6683c,#dc2743,#cc2366,#bc1888);color:#fff;font-family:'Oswald',sans-serif;font-weight:700;font-size:1rem;text-decoration:none;border-radius:2px;text-transform:uppercase;letter-spacing:0.08em;">
            <svg style="width:24px;height:24px;" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"/></svg>
            Síguenos en Instagram
          </a>
        </div>
      </div>
    </div>
  </section>
</Layout>
