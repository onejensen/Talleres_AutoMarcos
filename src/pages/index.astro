---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Talleres AutoMarcos - Taller Mecánico en Mallorca">
  <!-- Hero -->
  <section style="position:relative;background:#0a0f1a;padding:80px 0 96px;overflow:hidden;">
    <div style="position:absolute;inset:0;background-image:url('https://images.unsplash.com/photo-1486262715619-67b85e0b08d3?w=1920&q=80');background-size:cover;background-position:center;opacity:0.12;"></div>
    <div style="position:absolute;bottom:0;left:0;right:0;height:4px;background:#C0392B;"></div>
    <div style="position:relative;max-width:1280px;margin:0 auto;padding:0 24px;text-align:center;">
      <div style="display:inline-block;background:#C0392B;color:#fff;font-family:'Archivo Black',sans-serif;font-size:0.75rem;text-transform:uppercase;letter-spacing:0.15em;padding:8px 20px;margin-bottom:32px;">
        Taller Mecánico · Mallorca
      </div>
      <h1 style="font-family:'Archivo Black',sans-serif;font-size:clamp(2.5rem,6vw,5rem);font-weight:900;color:#fff;margin-bottom:24px;line-height:1.05;letter-spacing:-0.02em;">
        Tu taller mecánico de<br/><span style="color:#C0392B;">confianza</span> en Mallorca
      </h1>
      <p style="font-size:clamp(1rem,2vw,1.25rem);color:#9ca3af;max-width:640px;margin:0 auto 40px;line-height:1.6;font-family:system-ui,sans-serif;">
        Más de 20 años ofreciendo servicio profesional de reparación y mantenimiento de vehículos. Calidad, honestidad y compromiso con cada cliente.
      </p>
      <div style="display:flex;flex-wrap:wrap;gap:16px;justify-content:center;">
        <a href="/contacto" style="padding:16px 40px;background:#C0392B;color:#fff;font-family:'Archivo Black',sans-serif;font-size:1rem;text-decoration:none;border-radius:4px;text-transform:uppercase;letter-spacing:0.08em;font-weight:900;transition:background 0.15s;box-shadow:4px 4px 0 #96281b;" onmouseover="this.style.background='#96281b'" onmouseout="this.style.background='#C0392B'">
          Pedir Cita
        </a>
        <a href="/servicios" style="padding:16px 40px;background:transparent;color:#fff;font-family:'Archivo Black',sans-serif;font-size:1rem;text-decoration:none;border-radius:4px;border:2px solid #fff;text-transform:uppercase;letter-spacing:0.08em;font-weight:900;transition:all 0.15s;" onmouseover="this.style.background='rgba(255,255,255,0.1)'" onmouseout="this.style.background='transparent'">
          Nuestros Servicios
        </a>
      </div>
    </div>
  </section>

  <!-- Stats Bar -->
  <section style="background:#C0392B;padding:24px 0;">
    <div style="max-width:1280px;margin:0 auto;padding:0 24px;display:grid;grid-template-columns:repeat(2,1fr);gap:16px;" class="md:grid-cols-4">
      <div style="text-align:center;">
        <div style="font-family:'Archivo Black',sans-serif;font-size:2.5rem;font-weight:900;color:#fff;line-height:1;">20+</div>
        <p style="color:rgba(255,255,255,0.85);font-size:0.8rem;text-transform:uppercase;letter-spacing:0.1em;margin-top:4px;">Años de experiencia</p>
      </div>
      <div style="text-align:center;">
        <div style="font-family:'Archivo Black',sans-serif;font-size:2.5rem;font-weight:900;color:#fff;line-height:1;">5000+</div>
        <p style="color:rgba(255,255,255,0.85);font-size:0.8rem;text-transform:uppercase;letter-spacing:0.1em;margin-top:4px;">Clientes satisfechos</p>
      </div>
      <div style="text-align:center;">
        <div style="font-family:'Archivo Black',sans-serif;font-size:2.5rem;font-weight:900;color:#fff;line-height:1;">100%</div>
        <p style="color:rgba(255,255,255,0.85);font-size:0.8rem;text-transform:uppercase;letter-spacing:0.1em;margin-top:4px;">Compromiso</p>
      </div>
      <div style="text-align:center;">
        <div style="font-family:'Archivo Black',sans-serif;font-size:2.5rem;font-weight:900;color:#fff;line-height:1;">365</div>
        <p style="color:rgba(255,255,255,0.85);font-size:0.8rem;text-transform:uppercase;letter-spacing:0.1em;margin-top:4px;">Días de garantía</p>
      </div>
    </div>
  </section>

  <!-- Servicios destacados -->
  <section style="padding:80px 0;background:#0a0f1a;">
    <div style="max-width:1280px;margin:0 auto;padding:0 24px;">
      <div style="margin-bottom:48px;">
        <div style="display:inline-block;background:#C0392B;color:#fff;font-family:'Archivo Black',sans-serif;font-size:0.7rem;text-transform:uppercase;letter-spacing:0.15em;padding:6px 14px;margin-bottom:16px;">Servicios</div>
        <h2 style="font-family:'Archivo Black',sans-serif;font-size:clamp(2rem,4vw,3rem);font-weight:900;color:#fff;line-height:1.1;letter-spacing:-0.02em;">Nuestros Servicios</h2>
        <p style="color:#6b7280;margin-top:12px;max-width:480px;font-family:system-ui,sans-serif;">Ofrecemos una amplia gama de servicios para mantener tu vehículo en perfectas condiciones.</p>
      </div>
      <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:24px;">

        <div style="background:#111111;border:2px solid #1f2937;border-radius:4px;padding:32px;transition:all 0.15s;box-shadow:4px 4px 0 transparent;" onmouseover="this.style.borderColor='#C0392B';this.style.boxShadow='4px 4px 0 #C0392B'" onmouseout="this.style.borderColor='#1f2937';this.style.boxShadow='4px 4px 0 transparent'">
          <div style="width:48px;height:48px;background:#C0392B;border-radius:4px;display:flex;align-items:center;justify-content:center;margin-bottom:20px;">
            <svg style="width:24px;height:24px;color:#fff;" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.066 2.573c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.573 1.066c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.066-2.573c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
          </div>
          <h3 style="font-family:'Archivo Black',sans-serif;font-size:1.1rem;font-weight:900;color:#fff;margin-bottom:12px;">Mecánica General</h3>
          <p style="color:#6b7280;font-size:0.9rem;line-height:1.6;font-family:system-ui,sans-serif;">Diagnóstico y reparación completa de averías mecánicas de todo tipo de vehículos.</p>
        </div>

        <div style="background:#111111;border:2px solid #1f2937;border-radius:4px;padding:32px;transition:all 0.15s;box-shadow:4px 4px 0 transparent;" onmouseover="this.style.borderColor='#C0392B';this.style.boxShadow='4px 4px 0 #C0392B'" onmouseout="this.style.borderColor='#1f2937';this.style.boxShadow='4px 4px 0 transparent'">
          <div style="width:48px;height:48px;background:#C0392B;border-radius:4px;display:flex;align-items:center;justify-content:center;margin-bottom:20px;">
            <svg style="width:24px;height:24px;color:#fff;" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>
          </div>
          <h3 style="font-family:'Archivo Black',sans-serif;font-size:1.1rem;font-weight:900;color:#fff;margin-bottom:12px;">Electricidad del Vehículo</h3>
          <p style="color:#6b7280;font-size:0.9rem;line-height:1.6;font-family:system-ui,sans-serif;">Diagnóstico electrónico, reparación de sistemas eléctricos y electrónicos.</p>
        </div>

        <div style="background:#111111;border:2px solid #1f2937;border-radius:4px;padding:32px;transition:all 0.15s;box-shadow:4px 4px 0 transparent;" onmouseover="this.style.borderColor='#C0392B';this.style.boxShadow='4px 4px 0 #C0392B'" onmouseout="this.style.borderColor='#1f2937';this.style.boxShadow='4px 4px 0 transparent'">
          <div style="width:48px;height:48px;background:#C0392B;border-radius:4px;display:flex;align-items:center;justify-content:center;margin-bottom:20px;">
            <svg style="width:24px;height:24px;color:#fff;" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
          </div>
          <h3 style="font-family:'Archivo Black',sans-serif;font-size:1.1rem;font-weight:900;color:#fff;margin-bottom:12px;">Cambio de Aceite</h3>
          <p style="color:#6b7280;font-size:0.9rem;line-height:1.6;font-family:system-ui,sans-serif;">Cambio de aceite y filtros con productos de primera calidad para alargar la vida de tu motor.</p>
        </div>

        <div style="background:#111111;border:2px solid #1f2937;border-radius:4px;padding:32px;transition:all 0.15s;box-shadow:4px 4px 0 transparent;" onmouseover="this.style.borderColor='#C0392B';this.style.boxShadow='4px 4px 0 #C0392B'" onmouseout="this.style.borderColor='#1f2937';this.style.boxShadow='4px 4px 0 transparent'">
          <div style="width:48px;height:48px;background:#C0392B;border-radius:4px;display:flex;align-items:center;justify-content:center;margin-bottom:20px;">
            <svg style="width:24px;height:24px;color:#fff;" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18.364 18.364A9 9 0 005.636 5.636m12.728 12.728A9 9 0 015.636 5.636m12.728 12.728L5.636 5.636"/></svg>
          </div>
          <h3 style="font-family:'Archivo Black',sans-serif;font-size:1.1rem;font-weight:900;color:#fff;margin-bottom:12px;">Frenos</h3>
          <p style="color:#6b7280;font-size:0.9rem;line-height:1.6;font-family:system-ui,sans-serif;">Revisión, reparación y sustitución de sistemas de frenado. Tu seguridad es lo primero.</p>
        </div>

        <div style="background:#111111;border:2px solid #1f2937;border-radius:4px;padding:32px;transition:all 0.15s;box-shadow:4px 4px 0 transparent;" onmouseover="this.style.borderColor='#C0392B';this.style.boxShadow='4px 4px 0 #C0392B'" onmouseout="this.style.borderColor='#1f2937';this.style.boxShadow='4px 4px 0 transparent'">
          <div style="width:48px;height:48px;background:#C0392B;border-radius:4px;display:flex;align-items:center;justify-content:center;margin-bottom:20px;">
            <svg style="width:24px;height:24px;color:#fff;" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
          </div>
          <h3 style="font-family:'Archivo Black',sans-serif;font-size:1.1rem;font-weight:900;color:#fff;margin-bottom:12px;">ITV Pre-revisión</h3>
          <p style="color:#6b7280;font-size:0.9rem;line-height:1.6;font-family:system-ui,sans-serif;">Preparamos tu vehículo para pasar la ITV sin problemas. Revisión completa previa.</p>
        </div>

        <div style="background:#111111;border:2px solid #1f2937;border-radius:4px;padding:32px;transition:all 0.15s;box-shadow:4px 4px 0 transparent;" onmouseover="this.style.borderColor='#C0392B';this.style.boxShadow='4px 4px 0 #C0392B'" onmouseout="this.style.borderColor='#1f2937';this.style.boxShadow='4px 4px 0 transparent'">
          <div style="width:48px;height:48px;background:#C0392B;border-radius:4px;display:flex;align-items:center;justify-content:center;margin-bottom:20px;">
            <svg style="width:24px;height:24px;color:#fff;" fill="none" stroke="currentColor" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10" stroke-width="2"/><circle cx="12" cy="12" r="3" stroke-width="2"/></svg>
          </div>
          <h3 style="font-family:'Archivo Black',sans-serif;font-size:1.1rem;font-weight:900;color:#fff;margin-bottom:12px;">Neumáticos</h3>
          <p style="color:#6b7280;font-size:0.9rem;line-height:1.6;font-family:system-ui,sans-serif;">Venta, montaje y equilibrado de neumáticos de las mejores marcas del mercado.</p>
        </div>

      </div>
      <div style="text-align:center;margin-top:40px;">
        <a href="/servicios" style="padding:14px 36px;background:transparent;color:#C0392B;font-family:'Archivo Black',sans-serif;font-size:0.9rem;text-decoration:none;border-radius:4px;border:2px solid #C0392B;text-transform:uppercase;letter-spacing:0.08em;font-weight:900;transition:all 0.15s;display:inline-block;" onmouseover="this.style.background='#C0392B';this.style.color='#fff'" onmouseout="this.style.background='transparent';this.style.color='#C0392B'">
          Ver todos los servicios
        </a>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section style="padding:80px 0;background:#111111;border-top:3px solid #C0392B;border-bottom:3px solid #C0392B;">
    <div style="max-width:768px;margin:0 auto;padding:0 24px;text-align:center;">
      <h2 style="font-family:'Archivo Black',sans-serif;font-size:clamp(2rem,4vw,3rem);font-weight:900;color:#fff;margin-bottom:16px;letter-spacing:-0.02em;">¿Necesitas una revisión?</h2>
      <p style="color:#9ca3af;font-size:1.1rem;margin-bottom:32px;font-family:system-ui,sans-serif;">Contacta con nosotros y te daremos cita lo antes posible. Presupuesto sin compromiso.</p>
      <a href="https://wa.me/34600000000?text=Hola%2C%20me%20gustar%C3%ADa%20pedir%20cita%20en%20Talleres%20AutoMarcos" target="_blank" rel="noopener noreferrer" style="display:inline-flex;align-items:center;gap:12px;padding:16px 40px;background:#25d366;color:#fff;font-family:'Archivo Black',sans-serif;font-size:1rem;text-decoration:none;border-radius:4px;text-transform:uppercase;letter-spacing:0.08em;font-weight:900;transition:background 0.15s;box-shadow:4px 4px 0 #1da851;" onmouseover="this.style.background='#1da851'" onmouseout="this.style.background='#25d366'">
        <svg style="width:24px;height:24px;" fill="currentColor" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
        Escríbenos por WhatsApp
      </a>
    </div>
  </section>
</Layout>
