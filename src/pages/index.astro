---
import Layout from '../layouts/Layout.astro';

const servicios = [
  { num: '01', titulo: 'Mecánica General', desc: 'Diagnóstico y reparación completa de averías mecánicas de todo tipo de vehículos.', icono: 'M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.066 2.573c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.573 1.066c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.066-2.573c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z' },
  { num: '02', titulo: 'Electricidad del Vehículo', desc: 'Diagnóstico electrónico, reparación de sistemas eléctricos y electrónicos avanzados.', icono: 'M13 10V3L4 14h7v7l9-11h-7z' },
  { num: '03', titulo: 'Cambio de Aceite', desc: 'Cambio de aceite y filtros con productos de primera calidad para alargar la vida del motor.', icono: 'M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z' },
  { num: '04', titulo: 'Frenos', desc: 'Revisión, reparación y sustitución de sistemas de frenado. Tu seguridad es lo primero.', icono: 'M18.364 18.364A9 9 0 005.636 5.636m12.728 12.728A9 9 0 015.636 5.636m12.728 12.728L5.636 5.636' },
  { num: '05', titulo: 'ITV Pre-revisión', desc: 'Preparamos tu vehículo para pasar la ITV sin problemas. Revisión completa previa.', icono: 'M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z' },
  { num: '06', titulo: 'Neumáticos', desc: 'Venta, montaje y equilibrado de neumáticos de las mejores marcas del mercado.', icono: 'M12 2a10 10 0 100 20A10 10 0 0012 2zm0 4a6 6 0 110 12A6 6 0 0112 6z' },
];
---

<Layout title="Talleres AutoMarcos - Taller Mecánico en Mallorca">

  <!-- HERO — editorial/bold, full-screen with overlay -->
  <section style="position:relative;background:#0D0D0D;min-height:100vh;display:flex;align-items:center;overflow:hidden;">
    <div style="position:absolute;inset:0;background-image:url('https://images.unsplash.com/photo-1486262715619-67b85e0b08d3?w=1920&q=80');background-size:cover;background-position:center;opacity:0.18;"></div>
    <div style="position:absolute;inset:0;background:linear-gradient(to bottom, rgba(13,13,13,0.65) 0%, rgba(13,13,13,0.92) 100%);"></div>
    <div style="position:absolute;bottom:0;left:0;right:0;height:5px;background:#C0392B;"></div>

    <div style="position:relative;max-width:1280px;margin:0 auto;padding:0 24px;width:100%;">
      <div style="position:absolute;right:-20px;top:50%;transform:translateY(-50%);font-family:'Oswald',sans-serif;font-weight:700;font-size:clamp(8rem,20vw,22rem);color:#fff;opacity:0.03;line-height:1;pointer-events:none;user-select:none;letter-spacing:-0.02em;">20</div>

      <div style="max-width:900px;">
        <div style="display:inline-block;background:#C0392B;color:#fff;font-family:'Oswald',sans-serif;font-size:0.8rem;font-weight:500;text-transform:uppercase;letter-spacing:0.2em;padding:8px 20px;margin-bottom:36px;">
          Taller Mecánico · Mallorca
        </div>
        <h1 style="font-family:'Oswald',sans-serif;font-size:clamp(2.8rem,9vw,9rem);font-weight:700;color:#ffffff;margin-bottom:24px;line-height:0.9;letter-spacing:0.02em;text-transform:uppercase;">
          Tu taller<br/>de
          <span style="color:#C0392B;display:block;">confianza</span>
          en Mallorca
        </h1>

        <!-- Animated red draw line -->
        <div class="draw-line" style="max-width:500px;margin-bottom:24px;"></div>

        <!-- Animated experience counter -->
        <div style="display:flex;align-items:center;gap:16px;margin-bottom:32px;">
          <div style="font-family:'Oswald',sans-serif;font-size:clamp(3rem,7vw,6rem);font-weight:700;color:#C0392B;line-height:1;" id="exp-counter">0</div>
          <div style="font-family:'Oswald',sans-serif;font-size:clamp(1rem,2vw,1.4rem);color:rgba(255,255,255,0.7);text-transform:uppercase;letter-spacing:0.05em;line-height:1.2;">
            +<br/>años de<br/>experiencia
          </div>
        </div>

        <p style="font-size:clamp(1rem,2vw,1.25rem);color:rgba(255,255,255,0.7);max-width:580px;margin:0 0 44px;line-height:1.6;font-family:'Source Sans 3','Source Sans Pro',sans-serif;font-weight:300;">
          Calidad, honestidad y compromiso con cada cliente desde hace más de 20 años.
        </p>
        <div style="display:flex;flex-wrap:wrap;gap:16px;">
          <a href="/contacto" style="padding:18px 48px;background:#C0392B;color:#fff;font-family:'Oswald',sans-serif;font-size:1.1rem;font-weight:600;text-decoration:none;border-radius:2px;text-transform:uppercase;letter-spacing:0.12em;transition:background 0.15s,transform 0.15s;display:inline-block;" onmouseover="this.style.background='#96281b';this.style.transform='translateY(-2px)'" onmouseout="this.style.background='#C0392B';this.style.transform='translateY(0)'">
            Pedir Cita
          </a>
          <a href="/servicios" style="padding:18px 48px;background:transparent;color:#fff;font-family:'Oswald',sans-serif;font-size:1.1rem;font-weight:600;text-decoration:none;border-radius:2px;border:2px solid rgba(255,255,255,0.35);text-transform:uppercase;letter-spacing:0.12em;transition:all 0.15s;display:inline-block;" onmouseover="this.style.borderColor='rgba(255,255,255,0.7)';this.style.transform='translateY(-2px)'" onmouseout="this.style.borderColor='rgba(255,255,255,0.35)';this.style.transform='translateY(0)'">
            Nuestros Servicios
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- STATS BAR -->
  <section style="background:#C0392B;padding:28px 0;">
    <div class="stats-grid" style="max-width:1280px;margin:0 auto;padding:0 24px;display:grid;grid-template-columns:repeat(4,1fr);gap:16px;">
      <div style="text-align:center;">
        <div style="font-family:'Oswald',sans-serif;font-size:3rem;font-weight:700;color:#fff;line-height:1;">20+</div>
        <p style="color:rgba(255,255,255,0.8);font-family:'Source Sans 3','Source Sans Pro',sans-serif;font-size:0.8rem;text-transform:uppercase;letter-spacing:0.1em;margin-top:4px;">Años de experiencia</p>
      </div>
      <div style="text-align:center;">
        <div style="font-family:'Oswald',sans-serif;font-size:3rem;font-weight:700;color:#fff;line-height:1;">5000+</div>
        <p style="color:rgba(255,255,255,0.8);font-family:'Source Sans 3','Source Sans Pro',sans-serif;font-size:0.8rem;text-transform:uppercase;letter-spacing:0.1em;margin-top:4px;">Clientes satisfechos</p>
      </div>
      <div style="text-align:center;">
        <div style="font-family:'Oswald',sans-serif;font-size:3rem;font-weight:700;color:#fff;line-height:1;">100%</div>
        <p style="color:rgba(255,255,255,0.8);font-family:'Source Sans 3','Source Sans Pro',sans-serif;font-size:0.8rem;text-transform:uppercase;letter-spacing:0.1em;margin-top:4px;">Compromiso</p>
      </div>
      <div style="text-align:center;">
        <div style="font-family:'Oswald',sans-serif;font-size:3rem;font-weight:700;color:#fff;line-height:1;">365</div>
        <p style="color:rgba(255,255,255,0.8);font-family:'Source Sans 3','Source Sans Pro',sans-serif;font-size:0.8rem;text-transform:uppercase;letter-spacing:0.1em;margin-top:4px;">Días de garantía</p>
      </div>
    </div>
  </section>

  <!-- SERVICIOS — editorial list with large numbers -->
  <section style="padding:96px 0;background:#0D0D0D;position:relative;overflow:hidden;">
    <div style="position:absolute;left:-20px;top:50%;transform:translateY(-50%);font-family:'Oswald',sans-serif;font-weight:700;font-size:clamp(10rem,20vw,18rem);color:#fff;opacity:0.03;line-height:1;pointer-events:none;user-select:none;">06</div>

    <div style="max-width:1280px;margin:0 auto;padding:0 24px;">
      <div style="margin-bottom:64px;">
        <div style="display:inline-block;background:#C0392B;color:#fff;font-family:'Oswald',sans-serif;font-size:0.8rem;font-weight:500;text-transform:uppercase;letter-spacing:0.2em;padding:6px 16px;margin-bottom:16px;">Servicios</div>
        <h2 style="font-family:'Oswald',sans-serif;font-size:clamp(2.5rem,5vw,5rem);font-weight:700;color:#fff;line-height:1.0;text-transform:uppercase;">Nuestros Servicios</h2>
        <div style="width:100%;height:1px;background:#333;margin-top:24px;"></div>
      </div>

      <div style="display:flex;flex-direction:column;gap:0;">
        {servicios.map((s, i) => (
          <div
            class={`service-editorial-item ${i % 2 === 0 ? 'slide-in-left' : 'slide-in-right'}`}
            style="padding:36px 0;border-bottom:1px solid #1f1f1f;position:relative;"
          >
            <div class="service-editorial-row" style="display:grid;grid-template-columns:80px 1fr auto;gap:32px;align-items:center;">
              <div style="font-family:'Oswald',sans-serif;font-size:3.5rem;font-weight:700;color:#C0392B;line-height:1;letter-spacing:-0.02em;">{s.num}</div>
              <div>
                <h3 style="font-family:'Oswald',sans-serif;font-size:1.8rem;font-weight:600;color:#fff;text-transform:uppercase;letter-spacing:0.04em;margin-bottom:8px;">{s.titulo}</h3>
                <p style="color:rgba(255,255,255,0.55);font-family:'Source Sans 3','Source Sans Pro',sans-serif;font-size:1rem;line-height:1.6;max-width:600px;">{s.desc}</p>
                <div class="service-expand-line"></div>
              </div>
              <div class="service-icon-col" style="flex-shrink:0;">
                <div style="width:48px;height:48px;background:rgba(192,57,43,0.15);border:1px solid rgba(192,57,43,0.3);border-radius:2px;display:flex;align-items:center;justify-content:center;">
                  <svg style="width:22px;height:22px;color:#C0392B;" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={s.icono}/>
                  </svg>
                </div>
              </div>
            </div>
          </div>
        ))}
      </div>

      <div style="text-align:center;margin-top:56px;">
        <a href="/servicios" style="padding:16px 48px;background:transparent;color:#C0392B;font-family:'Oswald',sans-serif;font-size:1.05rem;font-weight:600;text-decoration:none;border-radius:2px;border:2px solid #C0392B;text-transform:uppercase;letter-spacing:0.12em;transition:all 0.15s;display:inline-block;" onmouseover="this.style.background='#C0392B';this.style.color='#fff'" onmouseout="this.style.background='transparent';this.style.color='#C0392B'">
          Ver todos los servicios →
        </a>
      </div>
    </div>
  </section>

  <!-- QUIÉNES SOMOS -->
  <section style="padding:96px 0;background:#111111;border-top:3px solid #C0392B;">
    <div style="max-width:1280px;margin:0 auto;padding:0 24px;">
      <div style="display:grid;grid-template-columns:1fr 1fr;gap:64px;align-items:center;">
        <div>
          <div style="display:inline-block;background:#C0392B;color:#fff;font-family:'Oswald',sans-serif;font-size:0.8rem;font-weight:500;text-transform:uppercase;letter-spacing:0.2em;padding:6px 16px;margin-bottom:24px;">Quiénes somos</div>
          <h2 style="font-family:'Oswald',sans-serif;font-size:clamp(2rem,4vw,4rem);font-weight:700;color:#fff;line-height:1.0;text-transform:uppercase;margin-bottom:24px;">Historia de un<br/><span style="color:#C0392B;">taller de confianza</span></h2>
          <div style="width:60px;height:3px;background:#C0392B;margin-bottom:24px;"></div>
          <p style="color:rgba(255,255,255,0.7);font-family:'Source Sans 3','Source Sans Pro',sans-serif;font-size:1rem;line-height:1.8;margin-bottom:16px;">
            Talleres AutoMarcos nació hace más de 20 años en Mallorca con una misión clara: ofrecer un servicio mecánico honesto, transparente y de calidad a los conductores de la isla.
          </p>
          <p style="color:rgba(255,255,255,0.7);font-family:'Source Sans 3','Source Sans Pro',sans-serif;font-size:1rem;line-height:1.8;margin-bottom:16px;">
            Empezamos como un pequeño taller familiar y hemos crecido hasta convertirnos en uno de los talleres más recomendados de Palma. Cada vehículo que entra por nuestras puertas recibe el mismo trato: diagnóstico honesto, presupuesto detallado y trabajo bien hecho.
          </p>
          <p style="color:rgba(255,255,255,0.7);font-family:'Source Sans 3','Source Sans Pro',sans-serif;font-size:1rem;line-height:1.8;">
            Apostamos por la tecnología sin olvidar los valores: transparencia, compromiso y respeto por el cliente. Así lo han entendido los más de 5.000 clientes que han confiado en nosotros.
          </p>
        </div>
        <div style="background:#161616;border-top:3px solid #C0392B;padding:48px;border-radius:2px;">
          <div style="display:grid;grid-template-columns:1fr 1fr;gap:32px;">
            {[
              {num:'20+', label:'Años de experiencia'},
              {num:'5K+', label:'Clientes satisfechos'},
              {num:'100%', label:'Transparencia'},
              {num:'365', label:'Días de garantía'},
            ].map(item => (
              <div style="text-align:center;padding:24px 16px;">
                <div style="font-family:'Oswald',sans-serif;font-size:2.8rem;font-weight:700;color:#C0392B;line-height:1;">{item.num}</div>
                <p style="color:rgba(255,255,255,0.55);font-family:'Source Sans 3',sans-serif;font-size:0.8rem;text-transform:uppercase;letter-spacing:0.1em;margin-top:8px;">{item.label}</p>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- CALIDAD GARANTIZADA -->
  <section style="padding:96px 0;background:#f5f5f5;border-top:5px solid #C0392B;">
    <div style="max-width:1280px;margin:0 auto;padding:0 24px;">
      <div style="text-align:center;margin-bottom:56px;">
        <div style="display:inline-block;background:#C0392B;color:#fff;font-family:'Oswald',sans-serif;font-size:0.8rem;font-weight:500;text-transform:uppercase;letter-spacing:0.2em;padding:6px 16px;margin-bottom:16px;">¿Por qué elegirnos?</div>
        <h2 style="font-family:'Oswald',sans-serif;font-size:clamp(2.5rem,5vw,4.5rem);font-weight:700;color:#0D0D0D;line-height:1.0;text-transform:uppercase;">Calidad garantizada</h2>
        <div style="width:100%;height:1px;background:#ddd;margin-top:24px;"></div>
      </div>
      <div class="grid-auto" style="display:grid;grid-template-columns:repeat(3,1fr);gap:2px;">
        {[
          {num:'01', t:'Experiencia', d:'Más de 20 años en el sector, con miles de clientes satisfechos en toda Mallorca.'},
          {num:'02', t:'Honestidad', d:'Presupuesto detallado antes de empezar. Sin sorpresas, sin letras pequeñas.'},
          {num:'03', t:'Tecnología', d:'Equipos de diagnóstico de última generación para todo tipo de vehículos.'},
        ].map(item => (
          <div class="slide-in-left" style="background:#fff;border-top:3px solid #C0392B;padding:40px 32px;transition:transform 0.2s;" onmouseover="this.style.transform='translateY(-3px)'" onmouseout="this.style.transform='translateY(0)'">
            <div style="font-family:'Oswald',sans-serif;font-size:3rem;font-weight:700;color:#C0392B;line-height:1;margin-bottom:16px;">{item.num}</div>
            <h3 style="font-family:'Oswald',sans-serif;font-size:1.8rem;font-weight:600;color:#0D0D0D;text-transform:uppercase;letter-spacing:0.04em;margin-bottom:12px;">{item.t}</h3>
            <div style="width:40px;height:2px;background:#C0392B;margin-bottom:16px;"></div>
            <p style="color:#555;font-family:'Source Sans 3','Source Sans Pro',sans-serif;font-size:1rem;line-height:1.6;">{item.d}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- TESTIMONIOS -->
  <section id="testimonios" style="padding:96px 0;background:#0D0D0D;border-top:3px solid #C0392B;">
    <div style="max-width:1280px;margin:0 auto;padding:0 24px;">
      <div style="text-align:center;margin-bottom:56px;">
        <div style="display:inline-block;background:#C0392B;color:#fff;font-family:'Oswald',sans-serif;font-size:0.8rem;font-weight:500;text-transform:uppercase;letter-spacing:0.2em;padding:6px 16px;margin-bottom:16px;">Clientes</div>
        <h2 style="font-family:'Oswald',sans-serif;font-size:clamp(2rem,4vw,4rem);font-weight:700;color:#fff;line-height:1.0;text-transform:uppercase;">Lo que dicen nuestros clientes</h2>
      </div>
      <div class="grid-auto" style="display:grid;grid-template-columns:repeat(3,1fr);gap:24px;">
        <div class="testimonio">
          <p>"Excelente servicio, arreglaron mi coche en el mismo día. Muy recomendable."</p>
          <cite>— Miguel Ángel R., Son Sardina</cite>
        </div>
        <div class="testimonio">
          <p>"Profesionales de verdad. Llevan años cuidando todos los coches de mi familia."</p>
          <cite>— Carmen F., Marratxí</cite>
        </div>
        <div class="testimonio">
          <p>"Transparentes con los precios y muy rápidos. El mejor taller de Palma."</p>
          <cite>— José Luis M., Es Rafal</cite>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section style="padding:96px 0;background:#0D0D0D;border-top:5px solid #C0392B;border-bottom:5px solid #C0392B;">
    <div style="max-width:768px;margin:0 auto;padding:0 24px;text-align:center;">
      <h2 style="font-family:'Oswald',sans-serif;font-size:clamp(2.5rem,6vw,5.5rem);font-weight:700;color:#fff;margin-bottom:8px;text-transform:uppercase;letter-spacing:0.02em;">¿Necesitas una revisión?</h2>
      <div style="width:100%;height:1px;background:#C0392B;opacity:0.3;margin:24px 0;"></div>
      <p style="color:rgba(255,255,255,0.6);font-size:1.1rem;margin-bottom:40px;font-family:'Source Sans 3','Source Sans Pro',sans-serif;font-weight:300;">Contacta con nosotros y te daremos cita lo antes posible. Presupuesto sin compromiso.</p>
      <a href="https://wa.me/34623942526?text=Hola%2C%20me%20interesa%20vuestros%20servicios" target="_blank" rel="noopener noreferrer" style="display:inline-flex;align-items:center;gap:12px;padding:18px 48px;background:#25d366;color:#fff;font-family:'Oswald',sans-serif;font-size:1.1rem;font-weight:600;text-decoration:none;border-radius:2px;text-transform:uppercase;letter-spacing:0.12em;transition:background 0.15s,transform 0.15s;" onmouseover="this.style.background='#1da851';this.style.transform='translateY(-2px)'" onmouseout="this.style.background='#25d366';this.style.transform='translateY(0)'">
        <svg style="width:24px;height:24px;" fill="currentColor" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
        Escríbenos por WhatsApp
      </a>
    </div>
  </section>

  <!-- IntersectionObserver + counter animation -->
  <script>
    (function() {
      // Slide-in animations
      const els = document.querySelectorAll('.slide-in-left, .slide-in-right');
      if (els.length) {
        const observer = new IntersectionObserver((entries) => {
          entries.forEach(entry => {
            if (entry.isIntersecting) {
              entry.target.classList.add('visible');
              observer.unobserve(entry.target);
            }
          });
        }, { threshold: 0.15 });
        els.forEach(el => observer.observe(el));
      }

      // Counter animation
      const counter = document.getElementById('exp-counter');
      if (counter) {
        let started = false;
        const startCounter = () => {
          if (started) return;
          started = true;
          let n = 0;
          const interval = setInterval(() => {
            n++;
            counter.textContent = n;
            if (n >= 20) clearInterval(interval);
          }, 60);
        };
        const obs = new IntersectionObserver((entries) => {
          if (entries[0].isIntersecting) startCounter();
        }, { threshold: 0.5 });
        obs.observe(counter);
      }

      // Stats: 4 columns on desktop
      const statsGrid = document.querySelector('.stats-grid');
      if (statsGrid && window.innerWidth >= 768) {
        (statsGrid as HTMLElement).style.gridTemplateColumns = 'repeat(4, 1fr)';
      }
    })();
  </script>
