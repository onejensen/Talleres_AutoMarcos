---
import Layout from '../layouts/Layout.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const servicios = [
  {
    titulo: 'Mecánica General',
    descripcion: 'Diagnóstico completo y reparación de todo tipo de averías mecánicas. Motor, transmisión, suspensión, dirección y más. Trabajamos con todas las marcas y modelos.',
    icono: 'M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.066 2.573c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.573 1.066c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.066-2.573c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z',
    iconoExtra: 'M15 12a3 3 0 11-6 0 3 3 0 016 0z',
  },
  {
    titulo: 'Electricidad del Vehículo',
    descripcion: 'Diagnóstico electrónico con equipos de última generación. Reparación de sistemas eléctricos, electrónicos, centralitas, sensores y cableado.',
    icono: 'M13 10V3L4 14h7v7l9-11h-7z',
  },
  {
    titulo: 'Cambio de Aceite y Filtros',
    descripcion: 'Cambio de aceite motor, aceite de transmisión y todos los filtros (aceite, aire, habitáculo, combustible). Usamos aceites de primera calidad homologados por el fabricante.',
    icono: 'M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z',
  },
  {
    titulo: 'Sistema de Frenos',
    descripcion: 'Revisión completa del sistema de frenado: pastillas, discos, pinzas, líquido de frenos y ABS. Tu seguridad es nuestra prioridad.',
    icono: 'M18.364 18.364A9 9 0 005.636 5.636m12.728 12.728A9 9 0 015.636 5.636m12.728 12.728L5.636 5.636',
  },
  {
    titulo: 'ITV Pre-revisión',
    descripcion: 'Revisión completa previa a la ITV para asegurar que tu vehículo pasa sin problemas. Comprobamos todos los puntos que se revisan en la inspección técnica.',
    icono: 'M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z',
  },
  {
    titulo: 'Neumáticos',
    descripcion: 'Venta, montaje, equilibrado y alineación de neumáticos. Trabajamos con las mejores marcas: Michelin, Continental, Bridgestone, Pirelli y más.',
    icono: 'M12 22c5.523 0 10-4.477 10-10S17.523 2 12 2 2 6.477 2 12s4.477 10 10 10z',
    iconoExtra: 'M12 15a3 3 0 100-6 3 3 0 000 6z',
  },
  {
    titulo: 'Aire Acondicionado',
    descripcion: 'Carga y reparación de sistemas de climatización. Revisión de gas refrigerante, compresores, condensadores y evaporadores.',
    icono: 'M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707',
  },
  {
    titulo: 'Distribución y Correas',
    descripcion: 'Cambio de kit de distribución, correas auxiliares y tensores. Fundamental para evitar averías graves en el motor.',
    icono: 'M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15',
  },
];
---

<Layout title="Servicios - Talleres AutoMarcos" description="Descubre todos los servicios de Talleres AutoMarcos: mecánica general, electricidad, frenos, neumáticos, ITV pre-revisión y mucho más en Mallorca.">
  <section style="padding:120px 0 96px;background:#080808;">
    <div style="max-width:1280px;margin:0 auto;padding:0 16px;">
      <div style="text-align:center;margin-bottom:64px;">
        <h1 style="font-family:'Oswald',sans-serif;font-size:clamp(2.5rem,5vw,4rem);font-weight:700;color:#fff;text-transform:uppercase;margin-bottom:16px;">Nuestros Servicios</h1>
        <p style="color:#9ca3af;font-size:1.1rem;max-width:768px;margin:0 auto;">En Talleres AutoMarcos ofrecemos un servicio integral para tu vehículo. Sea cual sea la avería o el mantenimiento que necesites, estamos aquí para ayudarte.</p>
      </div>

      <div style="display:grid;grid-template-columns:repeat(2,1fr);gap:24px;" class="grid-auto">
        {servicios.map((s) => (
          <article style="background:#161616;border-radius:8px;padding:32px;border:1px solid #222;">
            <div style="display:flex;align-items:flex-start;gap:20px;">
              <div style="width:56px;height:56px;background:rgba(245,166,35,0.1);border-radius:8px;display:flex;align-items:center;justify-content:center;flex-shrink:0;">
                <svg style="width:28px;height:28px;color:#F5A623;" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={s.icono}/>
                  {s.iconoExtra && <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={s.iconoExtra}/>}
                </svg>
              </div>
              <div>
                <h2 style="font-family:'Oswald',sans-serif;font-size:1.25rem;font-weight:600;color:#fff;margin-bottom:12px;">{s.titulo}</h2>
                <p style="color:#9ca3af;line-height:1.6;">{s.descripcion}</p>
              </div>
            </div>
          </article>
        ))}
      </div>

      <div style="margin-top:64px;background:linear-gradient(to right,#D4891A,#F5A623);border-radius:16px;padding:48px;text-align:center;">
        <h2 style="font-family:'Oswald',sans-serif;font-size:clamp(1.5rem,3vw,2rem);font-weight:700;color:#0D0D0D;margin-bottom:16px;">¿No encuentras lo que buscas?</h2>
        <p style="color:rgba(13,13,13,0.8);margin-bottom:32px;max-width:640px;margin-left:auto;margin-right:auto;">Contáctanos y cuéntanos qué necesita tu vehículo. Estaremos encantados de ayudarte y darte un presupuesto sin compromiso.</p>
        <a href={`${base}/contacto`} style="display:inline-block;padding:16px 32px;background:#0D0D0D;color:#F5A623;font-family:'Oswald',sans-serif;font-weight:700;border-radius:8px;text-decoration:none;font-size:1.1rem;text-transform:uppercase;letter-spacing:0.05em;">
          Solicitar Presupuesto
        </a>
      </div>
    </div>
  </section>
</Layout>
