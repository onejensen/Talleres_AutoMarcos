---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const { title, description = 'Talleres AutoMarcos - Tu taller mecánico de confianza en Mallorca. Mecánica general, electricidad, frenos, neumáticos, ITV y más.' } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="keywords" content="taller mecánico Mallorca, mecánica general, reparación coches Mallorca, ITV Mallorca, cambio aceite, frenos, neumáticos, electricidad vehículo" />
    <meta name="author" content="Talleres AutoMarcos" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_ES" />
    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Oswald:wght@400;500;600;700&family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet">
    <title>{title}</title>
  </head>
  <body class="bg-darker text-gray-200 min-h-screen flex flex-col">
    <div class="fixed inset-0 grain-overlay z-[100]"></div>

    <!-- Navigation -->
    <nav class="fixed top-0 w-full z-50 bg-[#131313]/70 backdrop-blur-md border-b border-white/10 shadow-2xl">
      <div class="flex justify-between items-center px-8 py-4 max-w-none w-full">
        <a href={`${base}/`} style="display:flex;align-items:center;gap:12px;text-decoration:none;">
          <img src={`${base}/logo-automarcos.svg`} width="64" alt="AutoMarcos logo" style="display:inline-block" />
          <div>
            <span style="font-size:1.5rem;font-weight:700;color:#fff;font-family:'Oswald',sans-serif;letter-spacing:-0.02em;">AutoMarcos</span>
            <span style="display:block;font-size:0.7rem;color:#F5A623;font-family:'Oswald',sans-serif;text-transform:uppercase;letter-spacing:0.1em;">Taller Mecánico · Mallorca</span>
          </div>
        </a>

        <!-- Desktop nav -->
        <div id="desktop-nav" style="display:flex;align-items:center;gap:8px;font-family:'Oswald',sans-serif;text-transform:uppercase;letter-spacing:0.1em;font-size:0.85rem;">
          <a style="color:rgba(255,255,255,0.7);text-decoration:none;padding:4px 12px;" href={`${base}/`}>Inicio</a>
          <a style="color:rgba(255,255,255,0.7);text-decoration:none;padding:4px 12px;" href={`${base}/servicios`}>Servicios</a>
          <a style="color:rgba(255,255,255,0.7);text-decoration:none;padding:4px 12px;" href={`${base}/galeria`}>Galería</a>
          <a style="color:rgba(255,255,255,0.7);text-decoration:none;padding:4px 12px;" href={`${base}/blog`}>Blog</a>
          <a style="color:rgba(255,255,255,0.7);text-decoration:none;padding:4px 12px;" href={`${base}/contacto`}>Contacto</a>
          <div style="height:24px;width:1px;background:rgba(255,255,255,0.1);margin:0 8px;"></div>
          <a href="https://wa.me/34623942526" target="_blank" rel="noopener" style="background:#F5A623;color:#0D0D0D;padding:8px 20px;font-weight:700;text-decoration:none;border-radius:2px;">Pedir Cita</a>
        </div>

        <!-- Mobile menu button -->
        <button id="mobile-menu-btn" style="display:none;color:#fff;background:none;border:2px solid #F5A623;padding:6px 10px;cursor:pointer;border-radius:4px;" aria-label="Abrir menú">
          <svg style="width:24px;height:24px;" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M4 6h16M4 12h16M4 18h16"/></svg>
        </button>
      </div>

      <!-- Mobile dropdown -->
      <div id="mobile-dropdown" style="display:none;flex-direction:column;gap:4px;padding:0 8px 16px;">
        <a href={`${base}/`} style="padding:12px 16px;color:#d1d5db;font-family:'Oswald',sans-serif;font-size:0.9rem;text-decoration:none;text-transform:uppercase;letter-spacing:0.05em;">Inicio</a>
        <a href={`${base}/servicios`} style="padding:12px 16px;color:#d1d5db;font-family:'Oswald',sans-serif;font-size:0.9rem;text-decoration:none;text-transform:uppercase;letter-spacing:0.05em;">Servicios</a>
        <a href={`${base}/galeria`} style="padding:12px 16px;color:#d1d5db;font-family:'Oswald',sans-serif;font-size:0.9rem;text-decoration:none;text-transform:uppercase;letter-spacing:0.05em;">Galería</a>
        <a href={`${base}/blog`} style="padding:12px 16px;color:#d1d5db;font-family:'Oswald',sans-serif;font-size:0.9rem;text-decoration:none;text-transform:uppercase;letter-spacing:0.05em;">Blog</a>
        <a href={`${base}/contacto`} style="padding:12px 16px;color:#d1d5db;font-family:'Oswald',sans-serif;font-size:0.9rem;text-decoration:none;text-transform:uppercase;letter-spacing:0.05em;">Contacto</a>
        <a href="https://wa.me/34623942526" target="_blank" rel="noopener" style="margin-top:8px;padding:14px 24px;background:#F5A623;color:#0D0D0D;font-family:'Oswald',sans-serif;font-size:0.9rem;text-decoration:none;text-align:center;border-radius:4px;text-transform:uppercase;letter-spacing:0.05em;font-weight:700;">Pedir Cita</a>
      </div>
    </nav>

    <main class="flex-1">
      <slot />
    </main>

    <!-- Footer -->
    <footer style="background:#131313;width:100%;padding:64px 0 32px;border-top:1px solid rgba(255,255,255,0.05);">
      <div style="display:grid;grid-template-columns:repeat(4,1fr);gap:48px;padding:0 32px;max-width:1280px;margin:0 auto;font-family:'Inter',sans-serif;font-size:0.9rem;line-height:1.6;" class="grid-auto">
        <div style="display:flex;flex-direction:column;gap:24px;">
          <div style="display:flex;align-items:center;gap:12px;">
            <img src={`${base}/logo-automarcos.svg`} width="42" alt="AutoMarcos logo" style="display:inline-block" />
            <span style="font-size:1.25rem;font-weight:700;color:#fff;font-family:'Oswald',sans-serif;text-transform:uppercase;letter-spacing:-0.02em;">AutoMarcos</span>
          </div>
          <p style="color:rgba(255,255,255,0.5);max-width:300px;">Especialistas en mecánica de alta precisión y mantenimiento integral en Mallorca. Más de 44 años cuidando su seguridad.</p>
          <div style="display:flex;gap:16px;">
            <a style="color:rgba(255,255,255,0.5);" href="https://www.instagram.com/talleres_automarcos" target="_blank" rel="noopener"><span class="material-symbols-outlined">photo_camera</span></a>
            <a style="color:rgba(255,255,255,0.5);" href="tel:+34623942526"><span class="material-symbols-outlined">phone</span></a>
            <a style="color:rgba(255,255,255,0.5);" href="https://wa.me/34623942526" target="_blank" rel="noopener"><span class="material-symbols-outlined">chat</span></a>
          </div>
        </div>
        <div style="display:flex;flex-direction:column;gap:24px;">
          <h4 style="color:#fff;font-family:'Oswald',sans-serif;font-weight:700;text-transform:uppercase;letter-spacing:0.1em;font-size:0.75rem;">Servicios</h4>
          <ul style="display:flex;flex-direction:column;gap:12px;color:rgba(255,255,255,0.5);list-style:none;padding:0;margin:0;">
            <li><a style="color:inherit;text-decoration:none;" href={`${base}/servicios`}>Mecánica General</a></li>
            <li><a style="color:inherit;text-decoration:none;" href={`${base}/servicios`}>Electricidad del Automóvil</a></li>
            <li><a style="color:inherit;text-decoration:none;" href={`${base}/servicios`}>Mantenimiento Preventivo</a></li>
            <li><a style="color:inherit;text-decoration:none;" href={`${base}/servicios`}>Inspección ITV</a></li>
          </ul>
        </div>
        <div style="display:flex;flex-direction:column;gap:24px;">
          <h4 style="color:#fff;font-family:'Oswald',sans-serif;font-weight:700;text-transform:uppercase;letter-spacing:0.1em;font-size:0.75rem;">Ubicación</h4>
          <ul style="display:flex;flex-direction:column;gap:12px;color:rgba(255,255,255,0.5);list-style:none;padding:0;margin:0;">
            <li style="display:flex;align-items:flex-start;gap:8px;">
              <span class="material-symbols-outlined" style="color:#F5A623;font-size:1rem;">location_on</span>
              <span>Carrer de Sant Joaquim, 25<br/>Mallorca</span>
            </li>
            <li style="display:flex;align-items:center;gap:8px;">
              <span class="material-symbols-outlined" style="color:#F5A623;font-size:1rem;">schedule</span>
              <span>Lunes a Sábado: 09:00 - 16:00</span>
            </li>
            <li style="display:flex;align-items:center;gap:8px;">
              <span class="material-symbols-outlined" style="color:#F5A623;font-size:1rem;">phone_iphone</span>
              <a href="tel:+34623942526" style="color:inherit;text-decoration:none;">623 94 25 26</a>
            </li>
          </ul>
        </div>
        <div style="display:flex;flex-direction:column;gap:24px;">
          <h4 style="color:#fff;font-family:'Oswald',sans-serif;font-weight:700;text-transform:uppercase;letter-spacing:0.1em;font-size:0.75rem;">Síguenos</h4>
          <p style="color:rgba(255,255,255,0.5);">Síguenos en Instagram para ver nuestro trabajo y ofertas.</p>
          <a href="https://www.instagram.com/talleres_automarcos" target="_blank" rel="noopener" style="color:#F5A623;text-decoration:none;font-family:'Oswald',sans-serif;text-transform:uppercase;letter-spacing:0.05em;font-weight:600;">@talleres_automarcos</a>
        </div>
      </div>
      <div style="max-width:1280px;margin:0 auto;padding:0 32px;margin-top:64px;padding-top:32px;border-top:1px solid rgba(255,255,255,0.05);display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:16px;">
        <p style="color:rgba(255,255,255,0.5);font-size:0.75rem;">&copy; {new Date().getFullYear()} Talleres AutoMarcos. Todos los derechos reservados.</p>
        <div style="display:flex;gap:24px;">
          <a style="color:rgba(255,255,255,0.5);font-size:0.75rem;text-decoration:none;" href="#">Privacidad</a>
          <a style="color:rgba(255,255,255,0.5);font-size:0.75rem;text-decoration:none;" href="#">Aviso Legal</a>
          <a style="color:rgba(255,255,255,0.5);font-size:0.75rem;text-decoration:none;" href="#">Cookies</a>
        </div>
      </div>
    </footer>

    <!-- Mobile sticky CTA -->
    <div class="mobile-sticky-cta fixed bottom-0 left-0 right-0 z-[999]">
      <a href="tel:+34623942526" style="flex:1;display:flex;align-items:center;justify-content:center;gap:8px;padding:14px 8px;background:#F5A623;color:#0D0D0D;font-family:'Oswald',sans-serif;font-size:0.9rem;font-weight:700;text-decoration:none;text-transform:uppercase;letter-spacing:0.05em;">
        <svg style="width:18px;height:18px;" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
        Llamar
      </a>
      <a href="https://wa.me/34623942526" target="_blank" rel="noopener" style="flex:1;display:flex;align-items:center;justify-content:center;gap:8px;padding:14px 8px;background:#25d366;color:#fff;font-family:'Oswald',sans-serif;font-size:0.9rem;font-weight:700;text-decoration:none;text-transform:uppercase;letter-spacing:0.05em;">
        <svg style="width:18px;height:18px;" fill="currentColor" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
        WhatsApp
      </a>
    </div>

    <!-- WhatsApp floating button (desktop) -->
    <a href="https://wa.me/34623942526" target="_blank" rel="noopener" style="position:fixed;bottom:24px;right:24px;z-index:999;width:56px;height:56px;border-radius:50%;background:#25d366;display:flex;align-items:center;justify-content:center;box-shadow:0 4px 16px rgba(37,211,102,0.5);text-decoration:none;" class="whatsapp-desktop" aria-label="WhatsApp">
      <svg style="width:30px;height:30px;color:#fff;" fill="currentColor" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
    </a>

    <style>
      @media (max-width: 767px) {
        #desktop-nav { display: none !important; }
        #mobile-menu-btn { display: block !important; }
        .whatsapp-desktop { display: none !important; }
      }
    </style>

    <script>
      const btn = document.getElementById('mobile-menu-btn');
      const dropdown = document.getElementById('mobile-dropdown');
      if (btn && dropdown) {
        btn.addEventListener('click', () => {
          const isOpen = dropdown.style.display === 'flex';
          dropdown.style.display = isOpen ? 'none' : 'flex';
        });
        dropdown.querySelectorAll('a').forEach(link => {
          link.addEventListener('click', () => {
            dropdown.style.display = 'none';
          });
        });
        document.addEventListener('click', (e) => {
          if (!dropdown.contains(e.target as Node) && !btn.contains(e.target as Node)) {
            dropdown.style.display = 'none';
          }
        });
      }
    </script>
  </body>
</html>
